-          fpi_ssm_jump_to_state (self->task_ssm, ENROLL_SEND_FRAME_ACQUIRE);
+          fp_dbg ("Received 0x%04x (%s) on frame_acquire; retrying (%d/%d left)...",
+                  status, status_to_str (status), *retry_idx, FRAME_ACQUIRE_NUM_RETRIES);
+          g_usleep (50000);
+          send_frame_acquire (self, capture_flags);
         }
       else
         {
           fpi_ssm_mark_failed (
               self->task_ssm,
               set_and_report_error (FP_DEVICE_ERROR_PROTO,
-                                    "Frame acquire max retries reached"));
+                                    "Frame acquire max retries reached (last status: 0x%04x)",
+                                    status));
         }
     }
   else
     {
       fpi_ssm_mark_failed (self->task_ssm,
                            set_and_report_error (FP_DEVICE_ERROR_PROTO,
-                                                 "Command failed with status: %s",
-                                                 status_to_str (status)));
+                                                 "Frame acquire failed with status: 0x%04x (%s)",
+                                                 status, status_to_str (status)));
     }
 }
 
