     }
@@ -907,6 +907,8 @@ send_tls_data (FpiDeviceSynaTlsMoc *self, guint8 *tdata, gsize tdata_size)
 
 /* VCSFW_CMD_FRAME_ACQ ===================================================== */
 
+static void send_frame_acquire (FpiDeviceSynaTlsMoc *self, guint8 capture_flags);
+
 static void
 recv_frame_acquire (FpDevice *device, guint8 *buffer_in, gsize length_in, GError *error)
 {
@@ -924,46 +926,54 @@ recv_frame_acquire (FpDevice *device, guint8 *buffer_in, gsize length_in, GError
     {
       fpi_ssm_next_state (self->task_ssm);
     }
